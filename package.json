{
  "name": "@critical-labs/qa-conductor",
  "version": "0.2.1",
  "description": "Side-by-side PR-QA harness: boots base-vs-PR app panes against cloned data behind mirrored proxies, with a pluggable five-seam adapter interface (Provisioner, BuildConvention, Seed, EnvTransform, AuthBootstrap).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critical-labs/qa-conductor.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "lib",
    "public"
  ],
  "exports": {
    ".": "./lib/server.mjs",
    "./session": "./lib/session.mjs",
    "./config": "./lib/config.mjs",
    "./docker": "./lib/docker.mjs",
    "./github": "./lib/github.mjs",
    "./identity": "./lib/identity.mjs",
    "./exec": "./lib/exec.mjs",
    "./proxy": "./lib/proxy.mjs",
    "./verdict": "./lib/verdict.mjs",
    "./adapters/provisioner-docker": "./lib/adapters/provisioner-docker.mjs",
    "./adapters/build-worktree": "./lib/adapters/build-worktree.mjs",
    "./adapters/provisioner-process": "./lib/adapters/provisioner-process.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node demo/server.mjs",
    "qa": "node qa/self.mjs"
  }
}

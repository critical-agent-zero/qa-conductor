{
  "name": "@critical-labs/qa-conductor",
  "version": "0.3.0",
  "description": "Side-by-side pull request QA: runs your app's base and PR builds on cloned data, mirrors both panes, posts a verdict.",
  "keywords": [
    "qa",
    "pull-request",
    "code-review",
    "review-app",
    "side-by-side",
    "preview",
    "github",
    "tailscale"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Critical Labs",
  "homepage": "https://github.com/critical-labs/qa-conductor#readme",
  "bugs": {
    "url": "https://github.com/critical-labs/qa-conductor/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critical-labs/qa-conductor.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin",
    "lib",
    "public"
  ],
  "bin": {
    "qa-conductor-expose": "bin/qa-conductor-expose.mjs"
  },
  "exports": {
    ".": "./lib/server.mjs",
    "./session": "./lib/session.mjs",
    "./config": "./lib/config.mjs",
    "./docker": "./lib/docker.mjs",
    "./github": "./lib/github.mjs",
    "./identity": "./lib/identity.mjs",
    "./exposure": "./lib/exposure.mjs",
    "./exec": "./lib/exec.mjs",
    "./proxy": "./lib/proxy.mjs",
    "./verdict": "./lib/verdict.mjs",
    "./adapters/provisioner-docker": "./lib/adapters/provisioner-docker.mjs",
    "./adapters/build-worktree": "./lib/adapters/build-worktree.mjs",
    "./adapters/provisioner-process": "./lib/adapters/provisioner-process.mjs",
    "./adapters/exposure-tailscale": "./lib/adapters/exposure-tailscale.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node demo/server.mjs",
    "qa": "node qa/self.mjs",
    "expose": "node bin/qa-conductor-expose.mjs --config qa/self.mjs#loadSelfQaConfig"
  }
}
